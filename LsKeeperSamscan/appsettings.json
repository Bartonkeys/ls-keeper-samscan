{
  "Apha": {
    "BaseUrl": "",
    "TokenUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "RateLimitPerSecond": 5
  },
  "DataBridge": {
    "BaseUrl": "",
    "PageSize": 100
  },
  "S3": {
    "BucketName": "ls-keeper-samscan",
    "Region": "eu-west-2",
    "Prefix": "samscan",
    "PreSignedUrlTtlDays": 7
  },
  "AllowedHosts": "*",
  "TraceHeader": "x-cdp-request-id",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ]
  }
}
