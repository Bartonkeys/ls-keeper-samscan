{
  "Apha": {
    "BaseUrl": "https://apha-integration-bridge.api.ext-test.cdp-int.defra.cloud",
    "TokenUrl": "https://apha-integration-bridge.api.ext-test.cdp-int.defra.cloud/oauth2/token",
    "ClientId": "",
    "ClientSecret": ""
  },
  "DataBridge": {
    "BaseUrl": "http://localhost:5000",
    "PageSize": 10
  },
  "S3": {
    "BucketName": "ls-keeper-samscan",
    "Region": "eu-west-2",
    "Prefix": "samscan",
    "PreSignedUrlTtlDays": 7,
    "ServiceUrl": "http://localhost:4566",
    "ForcePathStyle": true
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({Application}/{MachineName}/{ThreadId}/{SourceContext}.{Method}) {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
